# IntelliJ·VS Code 가 같이 읽는다. 팀원마다 인코딩·들여쓰기가 달라 diff 가 지저분해지는 것을 막는다
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

# Spring Initializr 가 만든 그대로 탭을 쓴다
[*.gradle]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
